<mxfile host="app.diagrams.net" agent="draw.io" version="24.0.0">
  <diagram name="ER · Plantillas Dinámicas de Endosos" id="er">
    <mxGraphModel dx="1500" dy="820" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="ban" value="MODELO ER · CONFIGURACIÓN DE PLANTILLAS DINÁMICAS DE ENDOSOS (varían por producto y tipo de endoso)" style="rounded=1;arcSize=14;fillColor=#002A8D;gradientColor=#1846B8;gradientDirection=east;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=24;shadow=1;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1400" height="52" as="geometry" /></mxCell>

        <mxCell id="prod" value="PRODUCTO&#10;──────────────&#10;id PK&#10;codigo UNIQUE (ej. &quot;Rumbo&quot;)&#10;nombre" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0FB;strokeColor=#002A8D;strokeWidth=2;shadow=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="tipo" value="TIPO_ENDOSO&#10;──────────────&#10;id PK&#10;codigo UNIQUE (ej. &quot;CambioFrecuencia&quot;)&#10;nombre" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0FB;strokeColor=#002A8D;strokeWidth=2;shadow=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="80" y="290" width="260" height="100" as="geometry" /></mxCell>

        <mxCell id="pl" value="PLANTILLA&#10;──────────────────────────&#10;id PK&#10;producto_id FK → PRODUCTO&#10;tipo_endoso_id FK → TIPO_ENDOSO&#10;event_description (ej. &quot;SolicitarEndoso&quot;)&#10;version INT · activo BOOL&#10;UNIQUE(producto_id, tipo_endoso_id, version)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#002A8D;strokeWidth=2;shadow=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="470" y="190" width="320" height="145" as="geometry" /></mxCell>

        <mxCell id="pc" value="PLANTILLA_CAMPO  (define dynamicData)&#10;──────────────────────────&#10;id PK · plantilla_id FK&#10;orden INT  ← orden exacto en el JSON de salida&#10;etiqueta (ej. &quot;NumeroPolizaEndoso&quot;)&#10;origen ENUM('INPUT','DEFAULT')&#10;campo_entrada NULL (ej. &quot;policyNumber&quot;)&#10;valor_default NULL (ej. &quot;SAC&quot;, &quot;TES008&quot;, &quot;&quot;)&#10;requerido BOOL&#10;UNIQUE(plantilla_id, orden) · UNIQUE(plantilla_id, etiqueta)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF1E7;strokeColor=#F26F21;strokeWidth=2;shadow=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="930" y="120" width="360" height="175" as="geometry" /></mxCell>

        <mxCell id="pe" value="PLANTILLA_EVENTO  (define eventAppliedEntities)&#10;──────────────────────────&#10;id PK · plantilla_id FK&#10;order_event INT · description (ej. &quot;AprobarEndoso&quot;)&#10;UNIQUE(plantilla_id, order_event)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF1E7;strokeColor=#F26F21;strokeWidth=2;shadow=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="930" y="330" width="360" height="110" as="geometry" /></mxCell>

        <mxCell id="ru" value="PLANTILLA_RISK_UNIT  (estructura riskUnitEntities)&#10;──────────────────────────&#10;id PK · plantilla_id FK&#10;risk_unit_number · insurance_object_number&#10;campo_plan_entrada (ej. &quot;plan&quot; → plansEntity.description)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF1E7;strokeColor=#F26F21;strokeWidth=2;shadow=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="930" y="475" width="360" height="110" as="geometry" /></mxCell>

        <mxCell id="r1" value="1..N" style="endArrow=none;strokeColor=#58595B;strokeWidth=1.5;fontSize=10;fontColor=#58595B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="190" as="sourcePoint" /><mxPoint x="470" y="230" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="r2" value="1..N" style="endArrow=none;strokeColor=#58595B;strokeWidth=1.5;fontSize=10;fontColor=#58595B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="340" as="sourcePoint" /><mxPoint x="470" y="300" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="r3" value="1..N (ordenado)" style="endArrow=none;strokeColor=#58595B;strokeWidth=1.5;fontSize=10;fontColor=#58595B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="230" as="sourcePoint" /><mxPoint x="930" y="200" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="r4" value="1..N (ordenado)" style="endArrow=none;strokeColor=#58595B;strokeWidth=1.5;fontSize=10;fontColor=#58595B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="280" as="sourcePoint" /><mxPoint x="930" y="380" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="r5" value="1..N" style="endArrow=none;strokeColor=#58595B;strokeWidth=1.5;fontSize=10;fontColor=#58595B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="320" as="sourcePoint" /><mxPoint x="930" y="525" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="key" value="EXTENSIBILIDAD — Un producto o tipo de endoso nuevo = INSERTs (producto/tipo + plantilla + campos + eventos), CERO cambios de código. El traductor lee la plantilla activa por (producto, tipoEndoso), arma dynamicData respetando &quot;orden&quot;, resuelve cada campo por &quot;origen&quot; (INPUT toma campo_entrada del JSON plano; DEFAULT usa valor_default; INPUT ausente con default → default; requerido ausente sin default → 422 con la lista de etiquetas faltantes) y construye eventAppliedEntities por order_event." style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#002A8D;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#002A8D;align=left;spacingLeft=16;shadow=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="640" width="1400" height="95" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
