# Obligatorias: el servidor no arranca si falta alguna.
JWT_SECRET=cambia-este-secreto
CLIENT_ID=frontend
CLIENT_SECRET=cambia-este-client-secret

# Opcionales
PORT=8080
# Orígenes permitidos para CORS, separados por coma. Default: *
CORS_ORIGIN=*

# Base de datos. DB_TYPE=sqlite (default) usa DB_PATH (default data/endorse.sqlite).
DB_TYPE=sqlite
DB_PATH=data/endorse.sqlite
# Para Postgres: DB_TYPE=postgres y DB_URL=postgres://usuario:clave@host:5432/endorse (requiere `npm install pg`).
# DB_URL=
