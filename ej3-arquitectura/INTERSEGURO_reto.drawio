        <mxCell id="imp" parent="1" style="rounded=1;arcSize=10;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;fontSize=12.5;fontStyle=1;fontColor=#C62828;align=left;spacingLeft=16;shadow=1;whiteSpace=wrap;" value="IMPACTO, Duplicidad de desembolsos (múltiples movimientos por póliza/cliente) - Recuperar dinero desembolsado de más es complejo y erosiona confianza - UX: el 502 hace percibir el sistema como inestable. CAUSA RAÍZ: la UX del cliente está acoplada síncronamente a la latencia de INARI, y no existe idempotencia, cada reintento es una operación nueva." vertex="1">
          <mxGeometry height="75" width="1400" x="50" y="470" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="TO BE · Arquitectura propuesta" id="wHTFouRLdfJkPcsABSlm">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1500" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ban" parent="1" style="rounded=1;arcSize=14;fillColor=#002A8D;gradientColor=#1846B8;gradientDirection=east;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=24;shadow=1;" value="TO BE · DESEMBOLSO ASÍNCRONO E IDEMPOTENTE, LA UX SE DESACOPLA DE LA LATENCIA DE INARI" vertex="1">
          <mxGeometry height="52" width="1400" x="50" y="30" as="geometry" />
        </mxCell>
        <mxCell id="cli" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#002A8D;gradientColor=#1846B8;strokeColor=none;fontColor=#FFFFFF;fontSize=11.5;fontStyle=1;shadow=1;" value="CLIENTE&lt;br&gt;Zona Segura&lt;br&gt;UI de estados: &quot;en proceso&quot;&lt;br&gt;-&amp;gt; push/polling del resultado" vertex="1">
          <mxGeometry height="110" width="190" x="60" y="170" as="geometry" />
        </mxCell>
        <mxCell id="gw" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#58595B;strokeWidth=2;shadow=1;fontSize=11;fontStyle=1;" value="API Gateway + WAF&lt;br&gt;JWT rate limiting&lt;br&gt;[INFRA]" vertex="1">
          <mxGeometry height="90" width="160" x="310" y="180" as="geometry" />
        </mxCell>
        <mxCell id="api" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#002A8D;strokeWidth=2;shadow=1;fontSize=10.5;fontStyle=1;" value="API Préstamos (Node)&lt;br&gt;POST /loans con Idempotency-Key&lt;br&gt;(hash póliza+cliente+monto+día)&lt;br&gt;UNIQUE constraint en BD&lt;br&gt;misma clave -&amp;gt; misma respuesta&lt;br&gt;responde 202 + loanRequestId" vertex="1">
          <mxGeometry height="130" width="230" x="530" y="160" as="geometry" />
        </mxCell>
        <mxCell id="db" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;gradientColor=#DCE6F7;strokeColor=#002A8D;strokeWidth=2;shadow=1;fontSize=10;fontStyle=1;" value="BD Solicitudes&lt;br&gt;estado + Idempotency-Key (UNIQUE)&lt;br&gt;RECIBIDA-&amp;gt;EN_PROCESO-&amp;gt;&lt;br&gt;DESEMBOLSADA / FALLIDA&lt;br&gt;+ outbox transaccional" vertex="1">
          <mxGeometry height="120" width="200" x="545" y="350" as="geometry" />
        </mxCell>
        <mxCell id="q" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF1E7;strokeColor=#F26F21;strokeWidth=2;shadow=1;fontSize=10.5;fontStyle=1;" value="Cola (Pub/Sub, SQS FIFO)&lt;br&gt;agrupada por póliza -&amp;gt;&lt;br&gt;concurrencia 1 por póliza&lt;br&gt;[INFRA]" vertex="1">
          <mxGeometry height="90" width="190" x="830" y="180" as="geometry" />
        </mxCell>
        <mxCell id="dlq" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;shadow=1;fontSize=10;" value="DLQ + alertas&lt;br&gt;(fallidos tras N reintentos)&lt;br&gt;-&amp;gt; revisión operativa" vertex="1">
          <mxGeometry height="70" width="190" x="830" y="330" as="geometry" />
        </mxCell>
        <mxCell id="wk" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#002A8D;strokeWidth=2;shadow=1;fontSize=10.5;fontStyle=1;" value="Worker Desembolsos&lt;br&gt;lock por póliza&lt;br&gt;timeout largo + circuit breaker&lt;br&gt;ANTES de reintentar: CONSULTA&lt;br&gt;estado en INARI (¿ya ejecutó?)&lt;br&gt;reintentos con backoff" vertex="1">
          <mxGeometry height="130" width="220" x="1090" y="160" as="geometry" />
        </mxCell>
        <mxCell id="in" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#58595B;strokeWidth=2;shadow=1;fontSize=10.5;fontStyle=1;" value="VMWARE INARI (admwr)&#xa;+ endpoint de consulta de estado&#xa;por referencia única de operación" vertex="1">
          <mxGeometry height="80" width="220" x="1090" y="350" as="geometry" />
        </mxCell>
        <mxCell id="not" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#002A8D;strokeWidth=2;shadow=1;fontSize=10.5;" value="Notificaciones&#xa;push / correo al cliente&#xa;con el resultado final" vertex="1">
          <mxGeometry height="80" width="160" x="310" y="350" as="geometry" />
        </mxCell>
        <mxCell id="conc" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF1E7;strokeColor=#F26F21;strokeWidth=2;shadow=1;fontSize=10;" value="Conciliación diaria&#xa;BD Solicitudes vs INARI:&#xa;toda diferencia = excepción&#xa;trazable (nada en estado&#xa;desconocido)" vertex="1">
          <mxGeometry height="100" width="190" x="38" y="360" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#F26F21;strokeWidth=2.5;fontSize=10.5;verticalAlign=bottom;" value="1. POST /loans">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="250" y="215" as="sourcePoint" />
            <mxPoint x="310" y="215" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#F26F21;strokeWidth=2.5;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="215" as="sourcePoint" />
            <mxPoint x="530" y="215" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#F26F21;strokeWidth=2;fontSize=10;verticalAlign=middle;fontColor=#58595B;" value="2. persiste + outbox (misma tx)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="645" y="290" as="sourcePoint" />
            <mxPoint x="645" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#F26F21;strokeWidth=2.5;fontSize=10.5;verticalAlign=bottom;" value="3. publica">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="215" as="sourcePoint" />
            <mxPoint x="830" y="215" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#F26F21;strokeWidth=2.5;fontSize=10.5;verticalAlign=bottom;" value="4. consume">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1020" y="215" as="sourcePoint" />
            <mxPoint x="1090" y="215" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#F26F21;strokeWidth=2.5;fontSize=10.5;verticalAlign=middle;fontColor=#58595B;" value="5. ejecuta / consulta estado">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1200" y="290" as="sourcePoint" />
            <mxPoint x="1200" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" style="endArrow=block;endFill=1;dashed=1;strokeColor=#C62828;strokeWidth=2;fontSize=10;fontColor=#C62828;verticalAlign=bottom;" value="fallidos">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="925" y="270" as="sourcePoint" />
            <mxPoint x="925" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" style="endArrow=block;endFill=1;dashed=1;strokeColor=#002A8D;strokeWidth=2;fontSize=10;fontColor=#002A8D;verticalAlign=bottom;" value="6. actualiza estado final">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="410" as="sourcePoint" />
            <mxPoint x="745" y="410" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" style="endArrow=block;endFill=1;dashed=1;strokeColor=#002A8D;strokeWidth=2;fontSize=10;fontColor=#002A8D;verticalAlign=bottom;" value="7. notifica resultado">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="545" y="395" as="sourcePoint" />
            <mxPoint x="470" y="395" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" style="endArrow=block;endFill=1;dashed=1;strokeColor=#002A8D;strokeWidth=2;fontSize=10;fontColor=#002A8D;verticalAlign=bottom;" value="push / GET /loans/{id}/status">
          <mxGeometry relative="1" x="0.4083" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="180" y="390" />
            </Array>
            <mxPoint x="310" y="390" as="sourcePoint" />
            <mxPoint x="180" y="280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="crit" parent="1" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#002A8D;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#002A8D;align=left;spacingLeft=16;shadow=1;whiteSpace=wrap;" value="CÓMO SE ELIMINA LA DUPLICIDAD (defensa en 3 capas), (1) Idempotency-Key con UNIQUE en BD: el reintento del cliente devuelve la MISMA solicitud, nunca crea otra · (2) Cola FIFO por póliza + lock: jamás dos desembolsos concurrentes de la misma póliza (3) El worker consulta el estado en INARI antes de reintentar: si ya ejecutó, solo registra el éxito. El cliente recibe 202 al instante (UX desacoplada de la latencia de INARI) y el resultado llega por push/polling." vertex="1">
          <mxGeometry height="85" width="1400" x="50" y="520" as="geometry" />
        </mxCell>
        <mxCell id="crit2" parent="1" style="rounded=1;arcSize=10;fillColor=#F5F7FA;strokeColor=#C6CBD4;fontSize=11.5;fontColor=#1A1A1A;align=left;spacingLeft=16;whiteSpace=wrap;" value="CRITERIOS, Escalabilidad: workers serverless autoescalables (Cloud Run/Functions), cola absorbe picos - Resiliencia: circuit breaker, backoff, DLQ, conciliación diaria · Concurrencia: FIFO por póliza + UNIQUE + lock - Seguridad: JWT en gateway, secretos en Secret Manager, auditoría de estados - Costo: 100% capa gratuita/serverless de GCP (Cloud Run + Pub/Sub + Cloud SQL/Firestore) pago por uso, sin servidores dedicados; INARI no se modifica salvo exponer consulta de estado." vertex="1">
          <mxGeometry height="90" width="1400" x="50" y="625" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
