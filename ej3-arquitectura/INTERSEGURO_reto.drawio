          </mxGeometry>
        </mxCell>
        <mxCell id="a4" edge="1" parent="1" style="endArrow=block;endFill=1;dashed=1;strokeColor=#C62828;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#C62828;verticalAlign=bottom;" value="4. 502 Bad Gateway (por lentitud/timeout), PERO INARI sigue ejecutando">
          <mxGeometry relative="1" as="geometry">
