          <mxGeometry height="90" width="180" x="70" y="200" as="geometry" />
        </mxCell>
        <mxCell id="be" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#002A8D;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;" value="Backend Node&#xa;(síncrono)" vertex="1">
          <mxGeometry height="90" width="180" x="380" y="191" as="geometry" />
        </mxCell>
        <mxCell id="px" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;fontColor=#C62828;" value="Proxy INARI&lt;br&gt;(timeout corto -&amp;gt;&lt;br&gt;devuelve 502)" vertex="1">
