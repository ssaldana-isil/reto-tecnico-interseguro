  <diagram name="AS IS · Problema actual" id="qQp1z1JcwZcl4KDH3fGk">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1500" pageHeight="700" math="0" shadow="0">
