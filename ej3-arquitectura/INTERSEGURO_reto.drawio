        <mxCell id="a2" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#F26F21;strokeWidth=2.5;fontSize=11;verticalAlign=bottom;" value="2. Llama admwr">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="230" as="sourcePoint" />
            <mxPoint x="690" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a3" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#F26F21;strokeWidth=2.5;fontSize=11;verticalAlign=bottom;" value="3. Reenvía">
          <mxGeometry relative="1" as="geometry">
