        </mxCell>
        <mxCell id="in" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#58595B;strokeWidth=2;shadow=1;fontSize=11.5;fontStyle=1;" value="VMWARE INARI&#xa;API admwr&#xa;(sigue procesando en&#xa;segundo plano y ejecuta)" vertex="1">
          <mxGeometry height="90" width="200" x="1000" y="200" as="geometry" />
        </mxCell>
        <mxCell id="a1" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#F26F21;strokeWidth=2.5;fontSize=11;verticalAlign=bottom;" value="1. Solicita desembolso">
          <mxGeometry relative="1" as="geometry">
