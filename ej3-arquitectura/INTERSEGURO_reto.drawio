            <mxPoint x="250" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a5" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#C62828;verticalAlign=bottom;curved=1;" value="5. Cliente cree que falló -&gt; REINTENTA -&gt; NUEVO desembolso del MISMO préstamo">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="380" />
            </Array>
            <mxPoint x="160" y="290" as="sourcePoint" />
