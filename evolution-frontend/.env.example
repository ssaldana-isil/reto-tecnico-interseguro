# URLs de los servicios (defaults si se omiten)
VITE_ENDORSE_API_URL=http://localhost:3001
VITE_ROUTES_API_URL=http://localhost:8080

# Credenciales client-credentials, una por servicio (deben coincidir con CLIENT_ID/CLIENT_SECRET de cada uno).
# ⚠ Todo lo que empieza con VITE_ queda embebido en el bundle y es visible para cualquiera: ver README.
VITE_ENDORSE_CLIENT_ID=frontend
VITE_ENDORSE_CLIENT_SECRET=
VITE_ROUTES_CLIENT_ID=frontend
VITE_ROUTES_CLIENT_SECRET=
